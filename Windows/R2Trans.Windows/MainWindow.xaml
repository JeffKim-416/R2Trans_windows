<Window x:Class="R2Trans.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620"
        Height="670"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.ColumnSpan="2"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="ApiKeyLabel"
                       Grid.Row="1"
                       Margin="0,22,16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <DockPanel Grid.Row="1"
                       Grid.Column="1"
                       Margin="0,22,0,0">
                <Button x:Name="PasteApiKeyButton"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Click="PasteApiKeyButton_Click" />
                <PasswordBox x:Name="ApiKeyBox" />
            </DockPanel>

            <TextBlock Grid.Row="2"
                       Margin="0,10,16,0" />
            <Button x:Name="CreateApiKeyButton"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    Click="CreateApiKeyButton_Click" />

            <TextBlock x:Name="AppLanguageLabel"
                       Grid.Row="3"
                       Margin="0,14,16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="AppLanguageCombo"
                      Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,14,0,0"
                      SelectionChanged="AppLanguageCombo_SelectionChanged" />

            <TextBlock x:Name="WorkModeLabel"
                       Grid.Row="4"
                       Margin="0,14,16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="WorkModeCombo"
                      Grid.Row="4"
                      Grid.Column="1"
                      Margin="0,14,0,0"
                      SelectionChanged="WorkModeCombo_SelectionChanged" />

            <TextBlock x:Name="TranslationModeLabel"
                       Grid.Row="5"
                       Margin="0,14,16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <Grid Grid.Row="5"
                  Grid.Column="1"
                  Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SourceLanguageCombo" />
                <TextBlock Grid.Column="1"
                           Text="->"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="TargetLanguageCombo"
                          Grid.Column="2" />
            </Grid>

            <TextBlock x:Name="AutoDetectLabel"
                       Grid.Row="6"
                       Margin="0,14,16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <Grid Grid.Row="6"
                  Grid.Column="1"
                  Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="AutoDetectCheckBox"
                          Checked="AutoDetectCheckBox_Changed"
                          Unchecked="AutoDetectCheckBox_Changed" />
                <ComboBox x:Name="AutoPairCombo"
                          Grid.Column="1"
                          Margin="12,0,0,0" />
            </Grid>

            <TextBlock x:Name="ConfirmBeforeReplaceLabel"
                       Grid.Row="7"
                       Margin="0,14,16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <CheckBox x:Name="ConfirmBeforeReplaceCheckBox"
                      Grid.Row="7"
                      Grid.Column="1"
                      Margin="0,14,0,0" />

            <TextBlock x:Name="StyleLabel"
                       Grid.Row="8"
                       Margin="0,14,16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="StyleCombo"
                      Grid.Row="8"
                      Grid.Column="1"
                      Margin="0,14,0,0" />

            <TextBlock x:Name="HotKeyLabel"
                       Grid.Row="9"
                       Margin="0,14,16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <TextBox x:Name="HotKeyTextBox"
                     Grid.Row="9"
                     Grid.Column="1"
                     Margin="0,14,0,0" />

            <TextBlock x:Name="ModelLabel"
                       Grid.Row="10"
                       Margin="0,14,16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="ModelCombo"
                      Grid.Row="10"
                      Grid.Column="1"
                      Margin="0,14,0,0" />

            <TextBlock Grid.Row="11"
                       Margin="0,14,16,0" />
            <Button x:Name="LiveInterpreterButton"
                    Grid.Row="11"
                    Grid.Column="1"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Stretch"
                    Click="LiveInterpreterButton_Click" />

            <TextBlock x:Name="LaunchAtLoginLabel"
                       Grid.Row="12"
                       Margin="0,14,16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Row="12"
                        Grid.Column="1"
                        Margin="0,14,0,0"
                        Orientation="Vertical">
                <CheckBox x:Name="LaunchAtLoginCheckBox" />
                <CheckBox x:Name="ShowTrayIconCheckBox"
                          Margin="0,8,0,0" />
                <TextBlock x:Name="TrayWarningText"
                           Margin="0,8,0,0"
                           Foreground="#666666"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Grid.Row="13"
                       Grid.ColumnSpan="2"
                       Margin="0,18,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="14"
                        Grid.ColumnSpan="2"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="CloseButton"
                        Click="CloseButton_Click" />
                <Button x:Name="SaveButton"
                        IsDefault="True"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
