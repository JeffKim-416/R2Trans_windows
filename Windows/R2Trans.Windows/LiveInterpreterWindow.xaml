<Window x:Class="R2Trans.Windows.LiveInterpreterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="840"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusLabel"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="TargetLanguageLabel"
                   Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="#666666" />

        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="InputSourceLabel"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="InputSourceCombo"
                      Grid.Column="1" />
            <TextBlock x:Name="OutputLanguageLabel"
                       Grid.Column="2"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="OutputLanguageCombo"
                      Grid.Column="3" />
            <CheckBox x:Name="KeepOnTopCheckBox"
                      Grid.Column="4"
                      Margin="18,0,0,0"
                      Checked="KeepOnTopCheckBox_Changed"
                      Unchecked="KeepOnTopCheckBox_Changed" />
        </Grid>

        <Grid Grid.Row="2"
              Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="SourceTranscriptLabel"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="TranslatedSubtitleLabel"
                       Grid.Column="2"
                       FontWeight="SemiBold" />
            <TextBox x:Name="SourceTranscriptBox"
                     Grid.Row="1"
                     Margin="0,8,0,0"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <TextBox x:Name="SubtitleBox"
                     Grid.Row="1"
                     Grid.Column="2"
                     Margin="0,8,0,0"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontSize="18"
                     FontWeight="SemiBold"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <Grid Grid.Row="3"
              Grid.ColumnSpan="2"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MicrophoneLevelLabel"
                       VerticalAlignment="Center" />
            <ProgressBar x:Name="MicrophoneLevelBar"
                         Grid.Column="1"
                         Height="12"
                         Maximum="1" />
            <TextBlock x:Name="SystemAudioLevelLabel"
                       Grid.Column="2"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center" />
            <ProgressBar x:Name="SystemAudioLevelBar"
                         Grid.Column="3"
                         Height="12"
                         Maximum="1" />
        </Grid>

        <TextBlock x:Name="DebugLabel"
                   Grid.Row="4"
                   Grid.ColumnSpan="2"
                   Margin="0,14,0,0"
                   Foreground="#666666"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="ClearButton"
                    Click="ClearButton_Click" />
            <Button x:Name="StartStopButton"
                    Click="StartStopButton_Click" />
            <Button x:Name="CloseButton"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
